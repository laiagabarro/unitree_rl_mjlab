<mujoco model="cube">

  <compiler
    angle="radian"
    autolimits="true"
  />

  <asset>

    <!--
      Fixed cube color.
    -->
    <material
      name="cube_mat"
      rgba="0.05 0.35 1.0 1"
    />

  </asset>

  <worldbody>

    <body
      name="cube"
      pos="0 0 0"
    >

      <freejoint/>

      <!--
        Default cube:

        half-size = 0.03 m
        full size = 0.06 m
        mass = 0.15 kg

        Size and mass are randomized at every
        environment reset by the domain-randomization
        events.
      -->
      <geom
        name="cube_geom"
        type="box"
        size="0.03 0.03 0.03"
        material="cube_mat"
        mass="0.15"
        contype="1"
        conaffinity="1"
      />

    </body>

  </worldbody>

</mujoco>